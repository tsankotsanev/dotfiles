# Treat Option key as Alt for terminal key sequences
# This makes Alt+hjkl work in tmux-tilish and other Alt-based keybinds
macos-option-as-alt = true

# Font
font-family = "FiraCode Nerd Font Mono"
font-size = 18

# Theme colors live in one of the theme-specific Stow packages:
#   ghostty-catppuccin -> ~/.config/ghostty/theme.conf
#   ghostty-onedark   -> ~/.config/ghostty/theme.conf
config-file = ~/.config/ghostty/theme.conf
